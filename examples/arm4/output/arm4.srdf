<?xml version='1.0' encoding='utf-8'?>
<robot name="arm4">
  <!-- generated by cad2urdf; collision matrix sampled on collision geometry -->
  <group name="arm">
    <chain base_link="base_link" tip_link="gripper_base" />
  </group>
  <group name="gripper">
    <joint name="finger_left" />
    <joint name="finger_right" />
  </group>
  <group_state name="home" group="arm">
    <joint name="shoulder_yaw" value="0" />
    <joint name="shoulder_pitch" value="0" />
    <joint name="elbow" value="0" />
    <joint name="wrist_roll" value="0" />
  </group_state>
  <group_state name="ready" group="arm">
    <joint name="shoulder_yaw" value="0" />
    <joint name="shoulder_pitch" value="0.6" />
    <joint name="elbow" value="1.2" />
    <joint name="wrist_roll" value="0" />
  </group_state>
  <group_state name="open" group="gripper">
    <joint name="finger_left" value="0.008" />
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="finger_left" value="-0.006" />
  </group_state>
  <end_effector name="hand" parent_link="gripper_base" group="gripper" parent_group="arm" />
  <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="base_link" />
  <passive_joint name="finger_right" />
  <disable_collisions link1="base_link" link2="turret" reason="Adjacent" />
  <disable_collisions link1="finger_left" link2="gripper_base" reason="Adjacent" />
  <disable_collisions link1="finger_right" link2="gripper_base" reason="Adjacent" />
  <disable_collisions link1="forearm" link2="gripper_base" reason="Adjacent" />
  <disable_collisions link1="forearm" link2="upper_arm" reason="Adjacent" />
  <disable_collisions link1="turret" link2="upper_arm" reason="Adjacent" />
  <disable_collisions link1="base_link" link2="finger_right" reason="Never" />
  <disable_collisions link1="base_link" link2="upper_arm" reason="Never" />
  <disable_collisions link1="finger_left" link2="finger_right" reason="Never" />
  <disable_collisions link1="finger_left" link2="forearm" reason="Never" />
  <disable_collisions link1="finger_left" link2="turret" reason="Never" />
  <disable_collisions link1="finger_left" link2="upper_arm" reason="Never" />
  <disable_collisions link1="finger_right" link2="forearm" reason="Never" />
  <disable_collisions link1="finger_right" link2="turret" reason="Never" />
  <disable_collisions link1="finger_right" link2="upper_arm" reason="Never" />
  <disable_collisions link1="forearm" link2="turret" reason="Never" />
  <disable_collisions link1="gripper_base" link2="turret" reason="Never" />
  <disable_collisions link1="gripper_base" link2="upper_arm" reason="Never" />
</robot>