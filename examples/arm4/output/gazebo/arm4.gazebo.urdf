  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="shoulder_yaw">
      <command_interface name="position">
        <param name="min">-2.97</param>
        <param name="max">2.97</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="shoulder_pitch">
      <command_interface name="position">
        <param name="min">-1.75</param>
        <param name="max">1.75</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="elbow">
      <command_interface name="position">
        <param name="min">-2.35</param>
        <param name="max">2.35</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="wrist_roll">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="finger_left">
      <command_interface name="position">
        <param name="min">-0.006</param>
        <param name="max">0.008</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="finger_right">
      <param name="mimic">finger_left</param>
      <param name="multiplier">1.0</param>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
  </ros2_control>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find arm4_description)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>
