# Copy to .env (git-ignored) and fill in:   cp .env.example .env
# cad2urdf reads .env automatically; values already exported in your shell take precedence.

# Onshape API keys: needed only for the `--cad onshape --format native` route.
# How to get them (personal vs Enterprise accounts): docs/ONSHAPE_API_KEYS.md
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=

# Optional: API base URL. Defaults to the domain of the document URL you pass,
# e.g. https://cad.onshape.com or https://yourteam.onshape.com
# ONSHAPE_API=https://cad.onshape.com
